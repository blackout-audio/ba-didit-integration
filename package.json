{
  "name": "ba-didit-integration",
  "version": "1.0.0",
  "description": "Shopify + Didit fraud verification integration app",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "worker:install": "npm --prefix workers install",
    "worker:dev": "npm --prefix workers run dev",
    "worker:check": "npm --prefix workers run check",
    "worker:deploy": "npm --prefix workers run deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@shopify/shopify-api": "^12.3.0",
    "@shopify/shopify-app-express": "^6.0.5",
    "dotenv": "^17.3.0",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
